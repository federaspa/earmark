<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.earmark.filer</string>
	<key>ProgramArguments</key>
	<array>
		<string>__UV__</string>
		<string>run</string>
		<string>--project</string>
		<string>__ROOT__</string>
		<string>python</string>
		<string>-m</string>
		<string>app.filer</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__ROOT__</string>
	<key>WatchPaths</key>
	<array>
		<string>__ROOT__/inbox</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__ROOT__/logs/filer.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__ROOT__/logs/filer.launchd.log</string>
</dict>
</plist>
